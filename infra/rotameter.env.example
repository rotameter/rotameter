# Copy to /etc/rotameter/rotameter.env (mode 0600, owned by rotameter:rotameter)
ROTAMETER_BIND=127.0.0.1:8000
ROTAMETER_DB=/var/lib/rotameter/rotameter.db
ROTAMETER_PUBLIC_URL=https://analytics.example.com
ROTAMETER_GEOIP=header
ROTAMETER_TRUSTED_PROXY=true
RUST_LOG=info

# Optional first-boot admin bootstrap key (remove after provisioning scoped keys)
# ROTAMETER_BOOTSTRAP_ADMIN_KEY=rm_adm_replace_with_32_byte_random_token

# Optional local self_site override
# ROTAMETER_SELF_SITE=true
# ROTAMETER_SELF_SITE_ID=_self

# Optional MaxMind GeoLite2/DB-IP fallback (if ROTAMETER_GEOIP=mmdb)
# ROTAMETER_MMDB_PATH=/var/lib/rotameter/GeoLite2-City.mmdb
