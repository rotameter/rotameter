{
  "name": "@rotameter/astro-cloudflare",
  "version": "0.1.0",
  "description": "Zero-dependency Astro and Cloudflare Workers first-party proxy and SSR analytics helper for Rotameter",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    },
    "./beacon": {
      "types": "./dist/beacon.d.ts",
      "import": "./dist/beacon.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "rotameter",
    "analytics",
    "astro",
    "cloudflare",
    "cloudflare-workers",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotameter/rotameter.git",
    "directory": "integrations/astro-cloudflare"
  },
  "homepage": "https://github.com/rotameter/rotameter/tree/main/integrations/astro-cloudflare#readme",
  "bugs": {
    "url": "https://github.com/rotameter/rotameter/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npx --yes -p typescript@5.8 tsc",
    "prepack": "npm run build",
    "typecheck": "npx --yes -p typescript@5.8 tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  }
}
