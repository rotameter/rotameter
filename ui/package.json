{
  "name": "rotameter-ui-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @rotameter/web dev",
    "build": "bun run --filter @rotameter/web build && bun scripts/compress-dist.mjs",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "vp lint apps/web/src packages/ui/src packages/plugin-sdk/src",
    "fmt": "vp fmt --check apps/web/src packages/ui/src packages/plugin-sdk/src",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite-plus": "latest"
  }
}
